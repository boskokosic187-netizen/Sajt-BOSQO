{"v":1,"pre":7.09,"dur":82.22,"fps":25,"subs":[{"id":"p1","t":[0.34,2.07],"text":"Hi, I'm Boško."},{"id":"p2","t":[2.09,6.21],"text":"I design and animate. This is my reel, and I'll walk you through it."},{"id":"p3","t":[6.23,7.5],"text":"Roll it."},{"id":"r1","t":[20.99,22.78],"text":"Wait for it…"},{"id":"r2","t":[24.51,28.53],"text":"Watch the cuts. Every project turns into the next one."},{"id":"r3","t":[30.31,32.98],"text":"Fan posters, for films I love."},{"id":"r4","t":[35.76,39.63],"text":"This one's for every client who ever said: make it bigger."},{"id":"r5","t":[39.65,41.59],"text":"One idea, every format."},{"id":"r6","t":[41.61,42.74],"text":"Phone."},{"id":"r7","t":[43.53,44.66],"text":"Feed."},{"id":"r8","t":[45.45,46.48],"text":"Billboard."},{"id":"r9","t":[47.37,48.52],"text":"Poster."},{"id":"r10","t":[49.36,52.15],"text":"Those are real. Over fifty of them."},{"id":"r11","t":[55.36,58.46],"text":"Key art. Built to hold up at 8K."},{"id":"r12","t":[61.91,63.07],"text":"Hold on."},{"id":"r13","t":[71.76,73.0],"text":"That's me."},{"id":"r14","t":[77.31,82.01],"text":"If you've got something that needs to move, I'm taking new projects. Say hi."}],"mouth":[[0,"S"],[8,"X"],[10,"AI"],[13,"E"],[15,"X"],[23,"E"],[26,"MBP"],[30,"O"],[32,"E"],[36,"O"],[39,"X"],[41,"S"],[52,"X"],[54,"AI"],[56,"E"],[61,"AI"],[63,"E"],[66,"AI"],[68,"L"],[70,"AI"],[73,"E"],[79,"X"],[97,"E"],[103,"MBP"],[105,"AI"],[107,"E"],[109,"U"],[112,"L"],[114,"X"],[122,"AI"],[127,"U"],[130,"E"],[134,"U"],[141,"E"],[145,"X"],[148,"S"],[159,"X"],[164,"E"],[169,"X"],[172,"S"],[524,"X"],[528,"E"],[532,"FV"],[536,"O"],[541,"E"],[548,"L"],[552,"X"],[555,"S"],[612,"X"],[616,"AI"],[620,"L"],[622,"E"],[628,"AI"],[632,"X"],[650,"E"],[657,"U"],[659,"O"],[661,"E"],[665,"L"],[668,"E"],[675,"L"],[678,"U"],[681,"E"],[689,"U"],[691,"AI"],[694,"L"],[696,"X"],[698,"S"],[759,"X"],[763,"AI"],[765,"MBP"],[767,"O"],[770,"L"],[772,"E"],[775,"X"],[787,"O"],[790,"E"],[796,"AI"],[798,"E"],[801,"L"],[803,"AI"],[805,